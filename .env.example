# URL reachable from the Partyfinder container. Include a proxy prefix, if used.
COPYPARTY_URL=https://copyparty.example.com/

# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# true behind an HTTPS reverse proxy; false only for local HTTP testing.
COOKIE_SECURE=true

# Host port exposed by Docker Compose.
PORT=3925

# Optional: if you renamed Copyparty's --pw-hdr.
COPYPARTY_AUTH_HEADER=PW

# Opt in only after reviewing README's folder-deletion risks (including nested volumes).
ALLOW_FOLDER_DELETE=false
