# URL reachable from both the container and your browser. Include a proxy prefix, if used.
COPYPARTY_URL=https://copyparty.example.com/

# Generate 64 random letters/digits with your password manager or https://bitwarden.com/password-generator/
# CLI alternative: openssl rand -hex 32
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# true behind an HTTPS reverse proxy; false only for local HTTP testing.
COOKIE_SECURE=true

# Host port exposed by Docker Compose.
PORT=3925

# Docker Hub version to deploy. Pin a release, or use latest for rolling updates.
PARTYFINDER_VERSION=1.0.0

# Optional: if you renamed Copyparty's --pw-hdr.
COPYPARTY_AUTH_HEADER=PW

# Opt in only after reviewing docs/usage.md's folder-deletion risks (including nested volumes).
ALLOW_FOLDER_DELETE=false
